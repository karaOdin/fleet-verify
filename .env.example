# Copy to .env and fill in. Never commit .env, never paste these values in a chat.
TRACCAR_URL=https://your-traccar-host
TRACCAR_TOKEN=                      # a Traccar user that sees only this company's devices, not an admin token
# Road papers: the tenant's data API. Token from `php artisan data-api:token issue --tenant=<id> --name=fleet-audit`
CLOUDROUTES_TENANT_URL=https://msila.routes.devcloud.dz
CLOUDROUTES_DATA_TOKEN=
# Lines and fleet registry (not built yet: leave empty to read data/inbox files)
CLOUDROUTES_URL=
CLOUDROUTES_TOKEN=
# CLOUDROUTES_BUSES_PATH=/api/v1/buses
# CLOUDROUTES_LINES_PATH=/api/v1/lines
KAFKA_BROKER=localhost:9092
POSTGRES_URL=postgresql://fleet:fleet@localhost:5432/fleet
POSTGRES_PORT=5432                  # host ports of docker-compose.yml; change if taken
KAFKA_UI_PORT=8080
DAGSTER_HOME=./.dagster

# ---- VPS (docker-compose.vps.yml)
DOMAIN=example.dz                   # serves pipeline.example.dz, dagster.example.dz, kafka.example.dz
ADMIN_USER=admin
ADMIN_HASH=                         # docker run --rm caddy:2.8 caddy hash-password --plaintext '...'
POSTGRES_PASSWORD=
VIZ_ADMIN_TOKEN=                    # needed to press the control buttons on the public page
VIZ_ANONYMIZE=1                     # show "حافلة A" instead of bus numbers
VIZ_DAY=2026-11-19
VIZ_DEMO_FROM=05:30
FLEET_POSITIONS_PREFER=inbox          # workshop: the batch uses the full exported day, not the partial replay in the lake
FLEET_PAPERS_PREFER=inbox             # workshop: road papers from data/inbox when the day's file exists (no live API on stage)
FLEET_DEVICES_PREFER=inbox            # workshop: Traccar device list from data/inbox/devices.json
# Note: Dagster reads this .env by itself; set the two above to "api" for a backfill from the real sources.
